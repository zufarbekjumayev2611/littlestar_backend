# ================================================================
# Little Star backend sozlamalari
# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring:
#     cp .env.example .env
# .env fayli GitHub'ga YUKLANMAYDI (.gitignore'da). Kalitlarni hech kimga bermang.
# ================================================================

# --- Server ---
PORT=3000

# --- Ma'lumotlar bazasi: Turso ---
# Turso panelidan yoki CLI'dan oling:
#   turso db show <baza-nomi> --url       ->  libsql://...turso.io
#   turso db tokens create <baza-nomi>    ->  token
# Bo'sh qoldirilsa, lokal fayl ishlatiladi (data/littlestar.db) — faqat sinash uchun.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Sayt (frontend) ---
# Build paytida sayt shu repodan olinadi va API bilan bitta manzilda ishlaydi (npm run build).
FRONTEND_REPO=https://github.com/zufarbekjumayev2611/littlestar.git
FRONTEND_BRANCH=claude/lucid-newton-48ghoe

# --- Manzillar (sayt va API bitta xizmatda bo'lsa, bularni BO'SH qoldiring) ---
# Faqat sayt boshqa joyda (masalan Netlify'da) joylashsa kerak bo'ladi.
# Backend (API) ning internetdagi manzili. Yuklangan fayl (video, rasm) havolalari shu bilan boshlanadi.
PUBLIC_URL=
# Frontend (sayt) manzili. To'lovdan keyin o'quvchi shu saytga qaytadi.
SITE_URL=
# Qaysi saytlar API'ga murojaat qila oladi (vergul bilan). Sinash paytida * qo'yish mumkin.
CORS_ORIGINS=

# --- Admin akkaunti ---
# Server ishga tushganda shu email va parol bilan admin yaratiladi (parol o'zgartirilsa — yangilanadi).
# Admin panelga (sayt/admin.html) shu email va parol bilan kiriladi.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Fayllar ---
# Yuklangan fayllar (vazifa rasmlari, PDF, videolar) Turso bazasida saqlanadi — disk kerak emas.
# O'qituvchi yuklashi mumkin bo'lgan eng katta fayl (MB). Katta videolar uchun YouTube havolasi qulayroq.
MAX_UPLOAD_MB=100

# --- To'lov: Payme (business.payme.uz) ---
# Kabinetda Endpoint URL:  https://api.littlestar.uz/api/pay/payme   ,  hisob maydoni: order_id
PAYME_MERCHANT_ID=
PAYME_KEY=
# Sinov (test.paycom.uz) paytida 1; haqiqiy to'lovlarga o'tganda 0 qiling
PAYME_TEST=1

# --- To'lov: Click (merchant.click.uz) ---
# Kabinetda Prepare URL:  https://api.littlestar.uz/api/pay/click/prepare
#           Complete URL: https://api.littlestar.uz/api/pay/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
